{
  "name": "setup-sandcastle-queue",
  "version": "1.0.0",
  "description": "Install a project-controlled Sandcastle GitHub Issues queue.",
  "type": "module",
  "bin": {
    "sandcastle-queue": "./dist/cli.js"
  },
  "files": [
    "LICENSE",
    "OPERATIONS.md",
    "README.md",
    "assets/queue-template/tool",
    "!assets/queue-template/tool/dist",
    "!assets/queue-template/tool/node_modules",
    "dist/canonical-json.js",
    "dist/cli.js",
    "dist/hash.js",
    "dist/mvp",
    "dist/version.js",
    "schema/mvp-config.schema.json"
  ],
  "engines": {
    "node": ">=22 <23"
  },
  "packageManager": "npm@10.9.7",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "libsodium-wrappers": "0.8.4"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "typescript": "5.9.3"
  },
  "license": "MIT"
}
