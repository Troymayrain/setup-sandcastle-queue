{
  "name": "setup-sandcastle-queue",
  "version": "0.1.0",
  "description": "Deterministic installer and runtime for a Sandcastle GitHub Issues agent queue.",
  "type": "module",
  "bin": {
    "sandcastle-queue": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "SKILL.md",
    "THIRD_PARTY_NOTICES.md",
    "agents",
    "assets",
    "dist",
    "schema",
    "scripts",
    "vendor"
  ],
  "engines": {
    "node": ">=22 <23"
  },
  "packageManager": "npm@10.9.7",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test:contracts": "node scripts/run-contract-ci.mjs",
    "test:fixture": "node scripts/run-credentialless-fixture.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "libsodium-wrappers": "0.8.4"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "typescript": "5.9.3"
  },
  "license": "MIT"
}
