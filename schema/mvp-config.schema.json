{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Troymayrain/setup-sandcastle-queue/schema/mvp-config.schema.json",
  "title": "Sandcastle Queue Template configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "repository",
    "queue",
    "runner",
    "commands",
    "models",
    "execution"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseBranch", "integrationBranch"],
      "properties": {
        "baseBranch": { "type": "string", "minLength": 1 },
        "integrationBranch": { "type": "string", "minLength": 1 }
      }
    },
    "queue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["readyLabel", "ownershipLabel"],
      "properties": {
        "readyLabel": { "type": "string", "minLength": 1 },
        "ownershipLabel": { "type": "string", "minLength": 1 }
      }
    },
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runsOn"],
      "properties": {
        "runsOn": { "type": "string", "minLength": 1 }
      }
    },
    "commands": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bootstrap", "test", "verification"],
      "properties": {
        "bootstrap": {
          "type": "array",
          "items": { "$ref": "#/$defs/command" }
        },
        "test": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/command" }
        },
        "verification": {
          "type": "array",
          "items": { "$ref": "#/$defs/command" }
        }
      }
    },
    "models": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ticket", "finalReview", "finalFix"],
      "properties": {
        "ticket": { "type": "string", "minLength": 1 },
        "finalReview": { "type": "string", "minLength": 1 },
        "finalFix": { "type": "string", "minLength": 1 }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hostFinalizationReserveMinutes"],
      "properties": {
        "hostFinalizationReserveMinutes": {
          "type": "integer",
          "minimum": 15,
          "maximum": 120
        }
      }
    }
  },
  "$defs": {
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["argv"],
      "properties": {
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
